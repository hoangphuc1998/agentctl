{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Manager",
  "version": "0.1.0",
  "identifier": "com.agentctl.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Manager",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "tmux", "git"]
      }
    }
  }
}
